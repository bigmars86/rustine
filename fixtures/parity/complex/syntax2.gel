grammar ssh_server_vrf_statements(default):
    match /ipv[46]/ fs 'access-list' fs nows fs /ipv[46]/ fs 'access-list' fs nows nl:
        out.add('$2?protocol="$0"&name="$4"')
        out.add('$2?protocol="$6"&name="$10"')
    do.return()

grammar ssh_server_statements(default):
    match /v[0-9]/ nl:
        out.add('version', '$0')
    match 'algorithms' fs nows:
        out.enter('$0?type="$2"')
        single_entries()
    match 'disable' fs 'hmac' fs 'hmac-sha1' nl:
        out.add('$4/$0')
    match 'enable' ws 'cipher' ws nows nl:
        out.add('$2', '$4')
    match 'netconf' fs 'vrf' fs nows:
        out.add('$0/$2?name="$4"')
        ssh_server_vrf_statements()
    match 'vrf' fs nows:
        out.enter('$0?name="$2"')
        ssh_server_vrf_statements()
    match nows fs number nl:
        out.add('$0', '$2')
    do.return()

grammar etag_set(default):
    skip end_stmt
    do.return()

grammar satellite_element(default):
    match 'type' ws nonl nl:
        out.add('$0', '$2')
    match 'secret' ws number ws nonl nl:
        out.add('$0?type="$2"', '$4')
    match 'device-name' ws nonl nl:
        out.add('$0', '$2')
    match 'upgrade' ws nonl nl:
        out.add('$0', '$2')
    do.return()

grammar nv_statements(default):
    match 'satellite' ws /\d+/ nl:
        out.enter('$0?name="$0 $2"')
        satellite_element()
    do.return()

grammar yang_server(default):
    match 'module-set' ws nonl nl:
        out.add('$0', '$2')
    do.return()

grammar grpc(default):
    match 'dscp' ws nows nl:
        out.add('$0', '$2')
    match 'port' ws number nl:
        out.add('$0', '$2')
    match 'address-family' ws nows nl:
        out.add('$0', '$2')
    do.return()

grammar tpa_protection_rules(default):
    match 'local-port' ws number:
        out.add('$0', '$2')
    match /(?:local|remote)-address/ ws ipvx_ip '/' number:
        out.add('$0?prefix="$4"', '$2')
    match nl:
        do.return()

grammar tpa_protection(default):
    match nows ws 'protocol' ws nows:
        out.enter('$0?$2="$4"')
        tpa_protection_rules()
    do.return()

grammar tpa_address_family(default):
    match 'address-family' ws nows nl:
        out.add('$0', '$2')
    match 'protection' nl:
        out.enter('$0')
        tpa_protection()
    do.return()

grammar tpa_vrf(default):
    match 'vrf' ws nows nl:
        out.add('$0', '$2')
    when 'address-family' ws nows nl:
        out.enter('address-families')
        tpa_address_family()
    do.return()

grammar tpa(default):
    when 'vrf' ws nows nl:
        out.enter('vrfs')
        tpa_vrf()
    do.return()

grammar install(default):
    do.return()

grammar healthcheck(default):
    do.return()

grammar ssh_client_statements(default):
    match 'algorithms' ws 'key-exchange' fs nonl nl:
        out.add('$0/$2', '$4')
    match 'disable' fs 'hmac' fs 'hmac-sha1' nl:
        out.add('$4/$0')
    match 'dscp' fs nows nl:
        out.add('$0', '$2')
    match 'enable' ws 'cipher' fs nows nl:
        out.add('$2', '$4')
    do.return()

grammar input(default):
    skip /Building configuration...[\r\n]+/
    skip /Current configuration : \d+ bytes[\r\n]+/
    skip /.* (?:UTC|MET) ?[\r\n]+/
    skip /WARNING:\s.*[\r\n]+/
    match 'apply-group' fs nonl nl:
        out.add('$0', '$2')
    match 'bfd' nl:
        out.add('$0')
        bfd_statements()
    match 'call-home' nl:
        out.enter('$0')
        call_home_statements()
    match 'cdp' nl:
        out.add('$0')
    match 'cef' fs nows nl:
        out.add('$0/$2')
        cef_statements()
    match 'banner' fs word fs multi_line_str_start:
        out.enter('banner/$2')
        banner_statements()
    match 'configuration display interface slot-order' nl:
        out.add('configuration/display/interface/', 'slot-oder')
    match 'crypto' fs 'ca' fs:
        out.enter('$0/$2')
        crypto_ca_statements()
    match 'domain lookup' fs nows fs nows nl:
        out.add('domain-lookup/$2', '$4')
    match 'domain name-server' fs nonl nl:
        out.add('name-server/server?address="$2"')
    match 'domain name' fs nonl nl:
        out.add('domain', '$2')
    match 'domain list' fs nonl nl:
        out.add('domain-list/domain?name="$2"')
    match 'fpd' fs nows fs nows nl:
        out.add('$0/$2/$4')
    match 'hostname' fs hostname nl:
        out.add('$0', '$2')
    match 'group' fs 'PPP' nl:
        out.enter('$0?name="$2"')
        ppp_group_statements()
    match 'license' fs 'smart' fs 'flexible-consumption' fs 'enable' nl:
        out.add('$0/$2/$4/$6')
    match 'lpts' fs 'pifib' fs 'hardware' fs 'police' nl:
        out.enter('$0/$2/$4/$6')
        lpts_statements()
    match 'netconf-yang agent' nl:
        out.enter('$0')
        ncy_agent_statements()
    match 'nv' nl:
        out.enter('$0')
        nv_statements()
    match 'segment-routing' nl:
        segment_routing_statements()
    match 'ssh client' fs:
        out.enter('$0')
        ssh_client_statements()
    match 'ssh server' fs:
        out.enter('$0')
        ssh_server_statements()
    match 'tacacs-server' fs 'host' fs nows fs 'port' fs number nl:
        out.enter('$0/host?name="$4"&port="$8"')
        tacacs_server_statements()
    match 'tacacs-server' fs 'key' fs number fs nonl nl:
        out.enter('$0/key?type="$4"&string="$6"')
        tacacs_server_statements()
    match 'tacacs' fs 'source-interface' fs nows fs 'vrf' fs nows nl:
        out.add('$0/$2?$6="$8"', '$4')
    match 'nsr' fs 'process-failures' fs nows nl:
        out.add('$0/$2', '$4')
    match 'tcp' fs nonl nl:
        out.add('$0?option="$2"')
    match 'telnet ipv4 client' fs 'source-interface' fs nows nl:
        out.add('$0/$2', '$4')
    match 'telnet vrf' fs name fs /ipv[46]/ fs:
        out.enter('telnet/vrf?name="$2"&protocol="$4"')
        telnet_vrf_statements()
    match 'yang-server' nl:
        out.enter('$0')
        yang_server()
    match 'attestation' ws 'runtime-integrity' ws 'cache' ws 'job' ws 'disable' nl:
        out.add('$0/$2/$4?$6="$8"')
    match 'vty-pool' fs nonl nl:
        out.add('$0?option="$2"')
    match 'grpc' nl:
        out.enter('$0')
        grpc()
    match 'tpa' nl:
        out.enter('$0')
        tpa()
    match 'evpn' nl:
        out.enter('$0')
        evpn_statements()
    acl()
    aaa()
    as_path_set()
    async_line()
    class_maps()
    clients()
    clock()
    community_set()
    confd()
    controller()
    disk_status()
    etag_set()
    event()
    flow()
    flowspec()
    healthcheck()
    hw_module()
    install()
    interface()
    ipsla()
    l2vpn()
    logging()
    memory_status()
    ntp()
    pfxl()
    policy_maps()
    prefix_set()
    protocols()
    route_policy()
    rpl_statements()
    sampler_map()
    service_commands()
    snmp()
    switch_fabric()
    taskgroup()
    usergroup()
    username()
    vrf()
    match 'end' nl:
        do.next()
