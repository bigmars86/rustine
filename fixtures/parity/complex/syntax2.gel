    do.return()

grammar username_statements(default):
    match 'group' fs name nl:
        out.add('$0?name="$2"')
    match 'secret' fs number fs nows nl:
        out.add('$0?type="$2"', '$4')
    do.return()

grammar username(default):
    match 'username' fs name nl:
        out.enter('user?name="$2"')
        username_statements()
    do.return()

grammar ntp_server_statements(default):
    match 'source' fs nows:
        out.add('$0', '$2')
    match nl:
        do.return()

grammar ntp_statements(default):
    match 'max-associations' fs number nl:
        out.add('$0', '$2')
    match 'server' fs ipvx_ip:
        out.enter('$0?address="$2"')
        ntp_server_statements()
    match 'update-calendar' nl:
        out.add('$0')
    match 'access-group' fs /ipv[46]/ fs nows fs nows nl:
        out.add('$0/$2?access-type="$4"&name="$6"')
    do.return()

grammar memory_status(default):
    do.return()

grammar ntp(default):
    match 'ntp' nl:
        out.enter('ntp')
        ntp_statements()
    do.return()

grammar policy_map_class_police_action_statements(default):
    match 'child-conform-aware' / */ nl:
        out.add('$0')
    match /[a-z]+-action/ fs nonl nl:
        out.add('$0', '$2')
    skip / *[\r\n]+/
    do.return()

grammar policy_map_class_police_rate_statements(default):
    match /rate|burst|peak-burst/ fs number fs nows:
        out.add_attribute('.', '$0', '$2 $4')
    match 'rate' fs /per\S+/ fs number:
        out.add_attribute('.', '$0', '$2')
    skip fs
    policy_map_class_police_action_statements()
    do.return()

grammar policy_map_class_statements(default):
    match 'bandwidth' fs nonl nl:
        out.add('$0', '$2')
    skip end_stmt
    match 'police' fs:
        out.enter('$0')
        policy_map_class_police_rate_statements()
    match 'priority' fs 'level' fs number / */ nl:
        out.enter('$0?level="$4"')
    match 'queue-limit' fs nonl nl:
        out.add('$0', '$2')
    match 'random-detect' fs nonl nl:
        out.add('$0', '$2')
    match 'service-policy' fs nows nl:
        out.add('$0?name="$2"')
    match 'set discard-class' fs name nl:
        out.add('$0', '$2')
    match 'set mpls experimental' fs 'imposition' fs number nl:
        out.add('$0?$2="$4"')
    match 'set precedence' fs name nl:
        out.add('$0', '$2')
    match 'set cos' fs number nl:
        out.add('$0', '$2')
    match 'set dscp' fs nows nl:
        out.add('$0', '$2')
    match 'shape' fs 'average' fs 'percent' fs number /[ \t]*/ nl:
        out.add('$0/$2/$4', '$6')
    match 'shape' fs 'average' fs number fs /[gkm]?bps/ /[ \t]*/ nl:
        out.add('$0/$2/$6', '$4')
    do.return()

grammar policy_map_statements(default):
    match 'class' fs nonl nl:
        out.enter('$0?name="$2"')
        policy_map_class_statements()
    do.return()

grammar policy_maps(default):
    match 'policy-map' fs nonl nl:
        out.enter('qos/$0?name="$2"')
        policy_map_statements()
    do.return()

grammar prefix_set_statements:
    match /\s*/ ipvx_prefix /,?/ nl:
        out.add('entry?prefix="$1"')
    match /\s*/ ipvx_prefix fs /[lg]e|eq/ fs number fs /[lg]e|eq/ fs number /,?/ nl:
        out.add('entry?prefix="$1"&$3="$5"&$7="$9"')
    match /\s*/ ipvx_prefix fs /[lg]e|eq/ fs number /,?/ nl:
        out.add('entry?prefix="$1"&$3="$5"')
    skip /\s*[!#][^\r\n]*[\r\n]/
    do.return()

grammar prefix_set(default):
    match 'prefix-set' fs nows nl:
        out.enter('$0?name="$2"')
        prefix_set_statements()
    skip end_stmt
    do.return()

grammar ppp_group_interface_statements(default):
    match 'ppp' fs 'ipcp' fs 'neighbor-route' fs nows nl:
        out.add('$2/$4', '$6')
    do.return()

grammar ppp_group_statements(default):
    match 'interface' fs /'/ /[^']+/ /'/ nl:
        out.enter('$0?name="$3"')
        ppp_group_interface_statements()
    skip end_stmt
    do.return()

grammar lpts_statements(default):
    match 'flow' fs nows fs 'rate' fs number nl:
        out.add('$0?type="$2"/$4', '$6')
    match 'flow' fs nows fs 'precedence' fs nonl nl:
        out.add('$0?type="$2"/$4', '$6')
    match 'flow' fs nows fs nows fs 'rate' fs number nl:
        out.add('$0?ftype="$2"&vtype="$4"/$6', '$8')
    match 'flow' fs nows fs nows fs 'precedence' fs nonl nl:
        out.add('$0?ftype="$2"&vtype="$4"/$6', '$8')
    match 'flow' fs nows fs nows fs nows fs 'precedence' fs nonl nl:
        out.add('$0?ftype="$2"&vtype="$4"&type="$6"/$8', '$10')
    do.return()

grammar ncy_agent_statements(default):
    match 'ssh' nl:
        out.add('$0')
    do.return()

grammar router_static_af_route_statements:
    skip ws
    match 'bfd fast-detect' fs nonl nl:
        out.add('$0', '$2')
    match 'description' fs nonl nl:
        out.add('$0', '$2')
    match 'tag' fs number:
        out.add('$0', '$2')
    do.return()

grammar router_static_af_statements(default):
    match ipv4_ip '/' number fs 'vrf' fs nows fs nows fs ipv4_ip:
        out.enter('static-route?ip="$0"&pfxlen="$2"&vrf="$6"/destination?interface="$8"&ip="$10"')
        router_static_af_route_statements()
    match ipvx_ip '/' number fs nows fs ipvx_ip:
        out.enter('static-route?ip="$0"&pfxlen="$2"/destination?interface="$4"&ip="$6"')
        router_static_af_route_statements()
    match ipvx_ip '/' number fs nows:
        out.enter('static-route?ip="$0"&pfxlen="$2"/destination?interface="$4"')
        router_static_af_route_statements()
    do.return()

grammar router_static_vrf_statements(default):
    match 'address-family' fs nonl nl:
        out.enter('$0?name="$2"')
        router_static_af_statements()
    do.return()

grammar router_static_statements(default):
    match 'address-family' fs nonl nl:
        out.enter('$0?name="$2"')
        router_static_af_statements()
    match 'vrf' fs nows nl:
        out.enter('$0?name="$2"')
        router_static_vrf_statements()
    do.return()

grammar route_policy_statements(default):
    match 'end-policy' nl:
        do.return()
    match nonl nl:
        do.skip()
    do.return()

grammar route_policy(default):
    match 'route-policy' fs nows nl:
        out.enter('$0?name="$2"')
        route_policy_statements()
    do.return()

grammar rpl_statements(default):
    do.return()

grammar switch_fabric(default):
    do.return()

grammar isis_interface_af_statements(default):
    match 'metric' fs nows fs 'level' fs number nl:
        out.add('$0?level="$6"', '$2')
    match 'mpls ldp sync' fs 'level' fs number nl:
        out.add('$0?$2="$4"')
    match 'prefix-sid' fs /index|absolute|strict-spf index/ fs number nl:
        out.add('$0?type="$2"&prefix="$4"')
    do.return()

grammar isis_interface_statements(default):
    match 'address-family' fs nonl nl:
        out.enter('address-family?name="$2"')
        isis_interface_af_statements()
    match 'circuit-type' fs /level-[12\-]-?\w*/ nl:
        out.add('$0', '$2')
    match 'hello-padding' fs 'disable' nl:
        out.add('$0/$2')
    match 'lsp-interval' fs number nl:
        out.add('$0', '$2')
    match 'mesh-group' fs number nl:
        out.add('$0', '$2')
    match 'passive' nl:
        out.add('$0')
    match 'point-to-point' nl:
        out.add('$0')
    do.return()

grammar isis_af_statements(default):
    match 'advertise' fs 'link attributes' nl:
        out.add('$0/$2')
    match 'interface' fs if_name nl:
        out.enter('$0?name="$2"')
        isis_interface_statements()
    match 'maximum-paths' fs number nl:
        out.add('$0', '$2')
    match 'router-id' fs nows nl:
        out.add('$0', '$2')
    match 'metric' fs number nl:
        out.add('$0', '$2')
    match 'metric-style' fs nonl nl:
        out.add('$0', '$2')
    match 'mpls traffic-eng' fs /level-[12]-only|multicast-intact/ nl:
        out.add('$0/$2')
    match 'redistribute' fs /connected|static|ospf \d+|isis \S+|bgp \S+/ fs /level-[0-9-]+/ fs:
        out.enter('redistribute/source?name="$2"&destination="$4"')
        redistribute_statements()
    match 'segment-routing' fs nows fs nows nl:
        out.add('$0/$2?preferred="$4"')
    match 'spf-interval' fs nonl nl:
        out.add('$0?option="$2"')
    match 'spf prefix-priority' fs nows fs name nl:
        out.add('$0?severity="$2"&pfxl="$4"')
    do.return()

grammar isis_statements(default):
    match 'address-family' fs nonl nl:
        out.enter('$0?name="$2"')
        isis_af_statements()
    match 'distribute' fs nows nl:
        out.add('$0?protocol="$2"')
    match 'is-type' ws nows nl:
        out.add('$0')
    match 'log adjacency changes' nl:
        out.add('$0')
    match /lsp-\w+-/ 'interval' fs number nl:
        out.add('$0/interval', '$2')
    match 'lsp-password' fs nonl nl:
        out.add('$0', '$2')
    match 'max-lsp-lifetime' fs number nl:
        out.add('$0', '$2')
    match 'net' fs nonl nl:
        out.add('$0', '$2')
    match 'nsf' fs /cisco|ietf/ nl:
        out.add('$0?method="$2"')
    do.return()

grammar tacacs_server_statements(default):
    do.return()

grammar mpls_ldp_interface_statements(default):
    do.return()

grammar mpls_ldp_label_statements(default):
    match 'allocate' fs 'for' fs nows nl:
        out.add('$0?$2="$4"')
    match /local|remote/ nl:
        out.enter('$0')
        mpls_ldp_label_statements()
    do.return()

grammar mpls_ldp_log_statements(default):
    match 'neighbor' nl:
        out.add('$0')
    match 'graceful-restart' nl:
        out.add('$0')
    match 'nsr' nl:
        out.add('$0')
    do.return()

grammar mpls_ldp_statements(default):
    match 'address-family' fs nows nl:
        out.enter('$0?name="$2"')
        mpls_ldp_statements()
    match 'interface' fs if_name nl:
        out.enter('$0?name="$2"')
        mpls_ldp_interface_statements()
    match 'label' nl:
        out.enter('label')
        mpls_ldp_label_statements()
    match 'log' nl:
        out.enter('log')
        mpls_ldp_log_statements()
    match 'session holdtime' fs number nl:
        out.add('$0', '$2')
    match 'router-id' fs nows nl:
