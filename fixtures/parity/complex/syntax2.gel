# Lexicon. Order does not matter.
define fs /[\t ]+/
define ws /\s+/
define nows /\S+/
define nl /[\r\n]+/
define nonl /[^\r\n]+/
define comment /[!#][^\r\n]*[\r\n]/
define number /\d+/
define word /\w+/
define name /\w[0-9a-zA-Z_-]*/
define hostname /\w[0-9a-zA-Z-]*/
define ipv4_ip /\d+\.\d+\.\d+\.\d+/
define ipv4_mask ipv4_ip
define ipv6_ip /(?:[a-fA-F0-9]*:){1,7}[a-fA-F0-9\.]*/
define ipvx_ip /[a-zA-Z0-9:\.]+[\.:][a-zA-Z0-9:\.]*/
define ipvx_prefix /[a-zA-Z0-9:\.]+[\.:][a-zA-Z0-9:\.]*\/\d+/
define if_name /[a-zA-Z\-]+[A-Z0-9\/\.:]+/
define multi_line_str_start /\^?[Cc=#+^] ?[\r\n]/
define multi_line_str_end /\^?[Cc=#+^][\r\n]/
define as_number /[1-9]\d{0,4}/
define description /[^\r\n]+/
define time /\d+:\d+:\d+/
define acl_action /(?:permit|deny)/
define acl_direction /(?:ingress|egress)/
define acl_name name
define async_line_name name
define end_stmt /end-[\-\w]+[\r\n]+/

# Define grammar.
grammar default:
    skip fs
    skip comment

grammar single_entries:
    match nl:
        do.return()
    match fs nows:
        out.add('entry?name="$1"')

grammar aaa(default):
    match 'aaa' fs nonl nl:
        out.add('aaa/option?string="$2"')
    do.return()

grammar acl_statements(default):
    match number fs 'remark' fs nonl nl:
        out.add('$2?seq="$0"&remark="$4"')
    match number fs acl_action fs nonl nl:
        out.add('$2?seq="$0"&condition="$4"')
    do.return()

grammar acl(default):
    match /ipv[46]/ fs 'access-list' fs name nl:
        out.enter('acl?name="$4"&protocol="$0"')
        acl_statements()
    do.return()

grammar pfxl(default):
    match /ipv[46]/ fs 'prefix-list' fs name nl:
        out.enter('prefix-list?name="$4"&protocol="$0"')
        acl_statements()
    do.return()

grammar as_path_set_statements(default):
    match 'ios-regex' fs /\'/ /[^']*/ /\',?/ nl:
        out.add('as-path?regex="$2"')
    match 'passes-through' fs /\'/ /[^']*/ /\',?/ nl:
        out.add('as-path?$0="$2"')
    do.return()

grammar as_path_set(default):
    match 'as-path-set' fs nows nl:
        out.enter('$0?name="$2"')
        as_path_set_statements()
    skip end_stmt
    do.return()

grammar async_line_statements(default):
    match /access-(?:group|class)/ fs acl_direction fs acl_name nl:
        out.add('$0?name="$2"/direction', '$4')
    match 'exec-timeout' fs number fs number nl:
        out.add('$0/minutes', '$2')
        out.add('$0/seconds', '$4')
    match 'session-timeout' fs number fs /(?:in|out)put/ nl:
        out.add('$0/$4', '$2')
    match 'login authentication' fs nows nl:
        out.add('$0/$2', '$2')
    match 'transport' fs nows fs nonl nl:
        out.add('$0/$2', '$4')
    do.return()

grammar async_line(default):
    match 'line' fs async_line_name nl:
        out.enter('async-line?name="$2"')
        async_line_statements()
    match 'line template' fs async_line_name nl:
        out.enter('async-line?name="$2"')
        async_line_statements()
    do.return()

grammar redistribute_statements:
    skip ws
    match 'metric' fs number:
        out.add('$0', '$2')
    match 'route-policy' fs nows:
        out.add('$0', '$2')
    do.return()

grammar bfd_statements(default):
    match 'multipath' fs 'include' fs 'location' fs nows nl:
        out.add('$0/$2?$4="$6"')
    match 'echo' fs 'disable' nl:
        out.add('echo/disable')
    do.return()

grammar call_home_profile_statements(default):
    match 'active' nl:
        out.add('$0')
    match 'destination address' fs nows fs nows nl:
        out.add('$0?type="$2"', '$4')
    match 'destination' fs 'transport-method' fs nows nl:
        out.add('$0/$2?type="$4"')
    match 'reporting' fs nows nl:
        out.add('$0', '$2')
    do.return()

grammar call_home_statements(default):
    match 'contact' fs 'smart-licensing' nl:
        out.add('$0/$2')
    match 'profile' fs nows nl:
        out.enter('$0?name="$2"')
        call_home_profile_statements()
    match 'service' fs 'active' nl:
        out.add('$0/$2')
    match 'source-interface' fs nows nl:
        out.add('$0', '$2')
    do.return()

grammar cef_statements(default):
    match 'fields' fs /l[34]/ fs nows nl:
        out.add('$0?type="$2"/$4')
    do.return()

grammar bgp_af_statements(default):
    match 'as-override' nl:
        out.add('$0')
    match 'allocate-label' fs word nl:
        out.add('$0', '$2')
    match 'bgp dampening' fs 'route-policy' fs nows nl:
        out.add('dampening/$2', '$4')
    match 'bgp dampening' fs number fs number fs number fs number nl:
        out.add('$0/half-life-timeout', '$2')
        out.add('$0/reuse-timeout', '$4')
        out.add('$0/suppress-value', '$6')
        out.add('$0/max-suppress-value', '$8')
    match 'bgp' fs 'origin-as' fs 'validation' fs nows nl:
        out.add('$0/$2/$4', '$6')
    match 'bestpath' fs 'origin-as' fs nows fs nows nl:
        out.add('$0/$2/$4', '$6')
    match 'default-originate' nl:
        out.add('$0')
    match 'label mode' fs nows nl:
        out.add('$0', '$2')
    match 'maximum-paths' fs /[ei]bgp/ fs number nl:
        out.add('$0/$2', '$4')
    match 'maximum-prefix' fs number fs number nl:
        out.add('$0?max="$2"&threshold="$4"')
    match 'maximum-prefix' fs number fs number fs 'restart' fs number nl:
        out.add('$0?max="$2"&threshold="$4"/$6', '$8')
    match 'maximum-prefix' fs number fs number fs nows nl:
        out.add('$0?max="$2"&threshold="$4"/$6')
    match 'network' fs ipvx_ip '/' number nl:
        out.add('$0?address="$2"&prefixlen="$4"')
    match 'network' fs ipvx_ip '/' number fs 'route-policy' fs nows nl:
        out.add('$0?address="$2"&prefixlen="$4"/$6', '$8')
    match 'next-hop-self' nl:
        out.add('$0')
    match 'redistribute' fs /(?:connected|static|ospf \d+)/:
        out.enter('redistribute/source?name="$2"')
        redistribute_statements()
    match 'remove-private-AS' nl:
        out.add('$0')
    match 'route-policy' fs nows fs /(?:in|out)/ nl:
        out.add('$0?name="$2"&direction="$4"', '$4')
    match 'route-reflector-client' nl:
        out.add('$0')
    match 'send-community-ebgp' nl:
        out.add('$0')
    match 'site-of-origin' fs nows nl:
        out.add('$0', '$2')
    match 'soft-reconfiguration' fs word fs nows nl:
        out.add('$0?direction="$2"/$4')
    match 'validation' fs nows nl:
        out.add('$0', '$2')
    match 'as-path-loopcheck' fs nows fs nows nl:
        out.add('$0?direction="$2"', '$4')
    do.return()

grammar bgp_neighbor_update_statements(default):
    match 'message' fs 'buffers' fs number nl:
        out.add('$0-$2', '$4')
    match 'attribute-filter' fs 'group' fs nows nl:
        out.add('$0?$2="$4"')
    do.return()

grammar bgp_neighbor_statements(default):
    match 'address-family' fs nonl nl:
        out.enter('$0?name="$2"')
        bgp_af_statements()
    match 'bfd' fs 'fast-detect' nl:
        out.add('$0/$2')
    match 'bfd' fs nows fs number nl:
        out.add('$0/$2', '$4')
    match 'capability suppress' fs nows nl:
        out.add('$0?capability="$2"')
    match 'description' fs nonl nl:
        out.add('$0', '$2')
    match 'ebgp-multihop' fs number nl:
        out.add('$0', '$2')
    match 'enforce-first-as' fs 'disable' nl:
        out.add('$0/$2')
    match 'local-as' fs number fs 'no-prepend' fs 'replace-as' nl:
        out.add('$0?as="$2"/$4')
        out.add('$0?as="$2"/$6')
    match 'password' fs nows nl:
        out.add('$0', '$2')
    match 'remote-as' fs number nl:
        out.add('$0', '$2')
    match 'update' fs nows fs 'filtering' nl:
        out.enter('$0?direction="$2"&type="$4"')
        bgp_neighbor_update_statements()
    match 'update-source' fs nows nl:
        out.add('$0', '$2')
    match 'use neighbor-group' fs nows nl:
        out.add('$0', '$2')
    match 'shutdown' nl:
        out.add('$0')
    do.return()

grammar bgp_vrf_statements(default):
    match 'address-family' fs nonl nl:
        out.enter('$0?name="$2"')
        bgp_af_statements()
    match 'rd' fs nows nl:
        out.add('$0', '$2')
    do.return()

grammar bgp_attribute_statements(default):
    match 'attribute' fs name fs nows nl:
        out.add('$0?name="$2"&action="$4"')
    do.return()

grammar rpki_server_statements(default):
    match 'bind-source' fs nows fs nows nl:
        out.add('$2', '$4')
    match 'transport' fs nows fs 'port' fs number nl:
        out.add('protocol', '$2')
        out.add('$4', '$6')
    match 'purge-time' fs number nl:
        out.add('$0', '$2')
    match 'refresh-time' fs number nl:
        out.add('$0', '$2')
    match 'response-time' fs number nl:
        out.add('$0', '$2')
    do.return()

grammar bgp_statements(default):
    match 'nsr' nl:
        out.add('$0')
    match 'attribute-filter' fs 'group' fs nows nl:
        out.enter('$0?$2="$4"')
        bgp_attribute_statements()
    match 'address-family' fs nonl nl:
        out.enter('$0?name="$2"')
        bgp_af_statements()
    match 'bgp router-id' fs nows nl:
        out.add('router-id', '$2')
    match 'bgp' fs 'origin-as' fs 'validation' fs 'time' fs number nl:
        out.add('$0/$2/$4/$6', '$8')
    match 'bgp' fs 'bestpath' fs 'origin-as' fs nows fs nows nl:
        out.add('$0/$2/$4/$6', '$8')
    match 'neighbor' fs ipv4_ip nl:
        out.enter('$0?address="$2"')
        bgp_neighbor_statements()
    match 'neighbor' fs ipv6_ip nl:
        out.enter('$0?address="$2"')
        bgp_neighbor_statements()
    match 'neighbor-group' fs nows nl:
        out.enter('$0?name="$2"')
        bgp_neighbor_statements()
    match 'vrf' fs nows nl:
        out.enter('$0?name="$2"')
        bgp_vrf_statements()
    match 'rpki server' fs ipv4_ip nl:
        out.enter('rpki-server?address="$2"')
        rpki_server_statements()
    do.return()

grammar class_map_statements(default):
    match 'match' fs nonl nl:
        out.add('$0?condition="$2"')
    match 'end-class-map' nl:
        do.return()
    do.return()

grammar class_maps(default):
    match 'class-map' fs /match-(?:any|all)/ fs nonl nl:
        out.add('qos/$0?name="$4"/mode/$2')
        out.enter('qos/$0?name="$4"')
        class_map_statements()
    do.return()

grammar client_statements(default):
    match 'source-interface' fs nows nl:
        out.add('$0', '$2')
        do.return()
    do.return()

grammar clients(default):
    match /(?:t?ftp|rcp) client/ fs:
        out.enter('$0')
        client_statements()
    do.return()

grammar clock(default):
    do.return()

grammar community_set_statements(default):
    match nows /,?/ nl:
        out.add('community?name="$0"')
    match /(?:ios|dfa)-regex/ fs nows /,?/ nl:
        out.add('$0', '$2')
    do.return()

grammar community_set(default):
    match 'community-set' fs nows nl:
        out.enter('$0?name="$2"')
        community_set_statements()
    match 'extcommunity-set' fs nows fs nows nl:
        out.enter('$0?attribute="$2"&name="$4"')
        community_set_statements()
    match 'large-community-set' fs nows nl:
        out.enter('$0?name="$2"')
        community_set_statements()
    skip end_stmt
    do.return()

grammar confd(default):
    do.return()

grammar controller_path_statements(default):
    do.return()

grammar controller_pm_statements(default):
    match 'pm' fs nows fs nows fs nows fs nows fs nows fs nows nl:
        out.add('$0?interval="$2"/$4/$6/$8?$10="$12"')
    match 'pm' fs nows fs nows fs nows ws nows fs nows nl:
        out.add('$0?interval="$2"/$4/$6/$8?$10')
    do.return()

grammar controller_statements(default):
    match 'DAC-Rate' fs nows nl:
        out.add('dac-rate', '$2')
    match 'dwdm-carrier' fs nows fs nows fs number nl:
        out.add('$0?grid="$2"&$4="$6"')
    match 'modulation' fs nows nl:
        out.add('$0', '$2')
    match 'fec' fs nows nl:
        out.add('$0/$2')
    match 'perf-mon' fs /(?:en|dis)able/ nl:
        out.add('$0/$2')
    match 'transmit-power' fs nows nl:
        out.add('$0')
    controller_path_statements()
    controller_pm_statements()
    do.return()

grammar controller(default):
    match 'controller' fs nonl nl:
        out.enter('controllers/$0?name="$2"')
        controller_statements()
    do.return()

grammar disk_status(default):
    do.return()

grammar event(default):
    do.return()

grammar flow_version_statements(default):
    match 'options' fs nonl nl:
        out.add('options/option?name="$2"')
    do.return()

grammar flow_statements(default):
    match 'record' fs /ipv[46]/ nl:
        out.add('$0/$2')
    match 'record' fs 'mpls' fs /(?:ipv[46](?:-ipv[46])?-)+fields/ fs 'labels' fs number nl:
        out.add('$0/$2/$4/$6', '$8')
    match 'cache' fs 'entries' fs nows nl:
        out.add('$0/$2', '$4')
    match 'cache' fs 'timeout' fs /(?:active|inactive|rate-limit)/ fs number nl:
        out.add('$0/$2/$4', '$6')
    match 'destination' fs nows nl:
        out.add('$0', '$2')
    match 'exporter' fs nows nl:
        out.add('$0', '$2')
    match 'source' fs nows nl:
        out.add('$0', '$2')
    match 'transport' fs /(?:tcp|udp)/ fs number nl:
        out.add('$0?protocol="$2"&port="$4"', '$4')
    match 'version' fs nows nl:
        out.add('$0', '$2')
        out.enter('controllers/$0?name="$2"')
        flow_version_statements()
    do.return()

grammar flow(default):
    match 'flow' fs /(?:monitor|exporter)-map/ fs name nl:
        out.enter('$0/$2?name="$4"')
        flow_statements()
    do.return()

grammar flowspec_statements(default):
    match 'local-install' fs name nl:
        out.add('$0?name="$2"')
    do.return()

grammar flowspec_af_statements(default):
    match 'address-family' fs /(ipv4|ipv6)/ nl:
        out.enter('$0?name="$2"')
        flowspec_statements()
    do.return()

grammar flowspec(default):
    match 'flowspec' nl:
        out.enter('flowspec')
        flowspec_af_statements()
    do.return()

grammar hw_module(default):
    match 'hw-module' fs 'l3' fs 'feature' fs nows fs nows nl:
        out.add('$0/$2/$6', '$8')
    match 'hw-module' fs 'location' fs nows fs 'port' fs number fs 'breakout' fs nows nl:
        out.add('$0?$2="$4"&$6="$8"/$10', '$12')
    match 'hw-module' fs nows fs nows nl:
        out.add('$0/$2', '$4')
    do.return()

grammar interface_l2transport_statements(default):
    match 'service-policy' fs /(?:in|out)put/ fs nows nl:
        out.add('$0?name="$4"&direction="$2"', '$4')
    do.return()

grammar satellite_fabric_link(default):
    match 'remote-ports' fs nows fs nows nl:
        out.add('$0?type="$2"', '$4')
    do.return()

grammar interface_nv_statements(default):
    match 'satellite-fabric-link' fs 'satellite' fs /\d+/ nl:
        out.enter('$0?id="$4"')
        satellite_fabric_link()
    do.return()

grammar interface_statements(default):
    match 'arp' fs 'timeout' fs number nl:
        out.add('$0-$2', '$4')
    match 'bandwidth' fs number nl:
        out.add('$0', '$2')
    match 'bundle' fs 'id' fs number fs 'mode' fs nows nl:
        out.add('$0?id="$4"/$6', '$8')
    match 'bundle' fs 'minimum-active links' fs number nl:
        out.add('$0/$2', '$4')
    match 'carrier-delay' fs 'up' fs number fs 'down' fs number nl:
        out.add('$0?up="$4"&down="$8"', '$8')
    match 'dampening' nl:
        out.add('$0')
    match 'description' fs description nl:
        out.add('description', '$2')
    match 'encapsulation' fs nonl nl:
        out.add('$0', '$2')
    match 'flow-control' fs nonl nl:
        out.add('$0', '$2')
    match 'flow' fs /ipv4|ipv6|mpls/ fs 'monitor' fs name fs 'sampler' fs name fs nows nl:
        out.add('$0?protocol="$2"&direction="$12"/$4', '$6')
        out.add('$0?protocol="$2"&direction="$12"/$8', '$10')
    match 'ipv4 address' fs ipv4_ip fs ipv4_mask nl:
        out.add('$0?address="$2"&mask="$4"')
    match /ipv[46]/ fs 'access-group' fs nows fs nows nl:
        out.add('$0/$2?name="$4"&direction="$6"')
    match /ipv[46]/ fs 'flowspec' fs nows nl:
        out.add('$0?$2="$4"')
    match /ipv[46]/ fs 'verify unicast source' fs 'reachable-via' fs nows nl:
        out.add('$0/$2?$4="$6"')
    match 'ipv6' fs 'nd' fs 'suppress-ra' nl:
        out.add('ipv6/$2/$4')
    match 'ipv6' fs 'address' fs ipv6_ip '/' number nl:
        out.add('ipv6/$2?address="$4"&prefixlen="$6"')
    match 'ipv6' fs 'enable' nl:
        out.add('$0/$2')
    match 'l2transport' nl:
        out.enter('$0')
        interface_l2transport_statements()
    match 'lacp period' ws nows nl:
        out.add('$0', '$2')
    match 'logging' fs 'events' fs nonl nl:
        out.add('$0 $2', '$4')
    match 'mtu' fs number nl
        | 'ipv4 mtu' fs number nl:
        out.add('$0', '$2')
    match 'negotiation' fs nonl nl:
        out.add('$0', '$2')
    match 'nv' nl:
        out.enter('$0')
        interface_nv_statements()
    match 'rewrite' fs 'ingress' fs 'tag' fs nows fs number fs 'symmetric' nl:
        out.add('$0?direction="$2"&$4="$6"&number="$8"&mode="$10"')
    match 'rewrite' fs 'ingress' fs 'tag' fs 'translate' fs nows fs 'dot1q' fs number fs 'symmetric' nl:
        out.add('$0?direction="$2"&$6="$8"&vlan="$12"&mode="$14"')
    match 'service-policy' fs /(?:in|out)put/ fs nows nl:
        out.add('$0?name="$4"&direction="$2"')
    match 'service-policy' fs /(?:in|out)put/ fs nows fs 'account' fs 'user-defined' fs number nl:
        out.add('$0?name="$4"&direction="$2"/$6?type="$8"', '$10')
    match 'shutdown' nl:
        out.add('disable')
    match 'vrf' fs name nl:
        out.add('$0', '$2')
    do.return()

grammar interface(default):
    match 'interface' fs if_name nl:
        out.enter('$0?name="$2"')
        interface_statements()
    match 'interface' fs if_name fs nows nl:
        out.enter('$0?name="$2"')
        out.add('type', '$4')
        interface_statements()
    do.return()

grammar evpn_evi_bgp_statements(default):
    match 'rd' ws nows nl:
        out.add('$0', '$2')
    match 'route-target' ws 'import' ws nows nl:
        out.add('$0/$2', '$4')
    match 'route-target' ws 'export' ws nows nl:
        out.add('$0/$2', '$4')
    do.return()

grammar evpn_evi_statements(default):
    match 'bgp' nl:
        out.enter('$0')
        evpn_evi_bgp_statements()
    do.return()

grammar evpn_statements(default):
    match 'evi' ws nows nl:
        out.enter('$0?id="$2"')
        evpn_evi_statements()
    do.return()

grammar ipsla(default):
    do.return()

grammar l2vpn_bridge_group_bridge_domain_mac_aging_statements(default):
    match 'time' fs number nl:
        out.add('$0', '$2')
    do.return()

grammar l2vpn_bridge_group_bridge_domain_mac_limit_statements(default):
    match 'action' fs nows nl:
        out.add('$0', '$2')
    match 'maximum' fs number nl:
        out.add('$0', '$2')
    match 'notification' fs nows nl:
        out.add('$0', '$2')
    do.return()

grammar l2vpn_bridge_group_bridge_domain_mac_statements(default):
    match 'aging' nl:
        out.enter('$0')
        l2vpn_bridge_group_bridge_domain_mac_aging_statements()
    match 'limit' nl:
        out.enter('$0')
        l2vpn_bridge_group_bridge_domain_mac_limit_statements()
    match 'withdraw disable' nl:
        out.add('widthdraw/disable')
    match 'learning' ws 'disable' nl:
        out.add('$0/$2')
    do.return()

grammar l2vpn_bridge_group_bridge_domain_vfi_neighbor_statements(default):
    match 'pw-class' fs nows nl:
        out.add('$0', '$2')
    do.return()

grammar l2vpn_bridge_group_bridge_domain_vfi_statements(default):
    match 'neighbor' fs ipvx_ip fs 'pw-id' fs number nl:
        out.enter('$0?address="$2"')
        out.add('pw-id', '$6')
        l2vpn_bridge_group_bridge_domain_vfi_neighbor_statements()
    do.return()

grammar l2vpn_bridge_group_bridge_domain_interface_statements(default):
    match 'storm-control' fs nows fs nows fs number nl:
        out.add('$0/$2', '$6 $4')
    do.return()

grammar l2vpn_bridge_group_bridge_domain_statements(default):
    match 'mac' nl:
        out.enter('$0')
        l2vpn_bridge_group_bridge_domain_mac_statements()
    match 'mtu' fs number nl:
        out.add('$0', '$2')
    match 'interface' fs if_name nl:
        out.enter('$0?name="$2"')
        l2vpn_bridge_group_bridge_domain_interface_statements()
    match 'vfi' fs number nl:
        out.enter('$0?name="$2"')
        l2vpn_bridge_group_bridge_domain_vfi_statements()
    match 'evi' ws nows nl:
        out.add('$0', '$2')
    do.return()

grammar l2vpn_bridge_group_statements(default):
    match 'bridge-domain' fs nows nl:
        out.enter('$0?name="$2"')
        l2vpn_bridge_group_bridge_domain_statements()
    do.return()

grammar l2vpn_pwclass_encap_load_balancing_statements(default):
    match 'flow-label' fs nows nl:
        out.add('$0', '$2')
    do.return()

grammar l2vpn_pwclass_encap_statements(default):
    match 'control-word' nl:
        out.add('$0')
    match 'protocol' fs nows nl:
        out.add('$0', '$2')
    match 'transport-mode' fs nows nl:
        out.add('$0', '$2')
    match 'transport-mode vlan' fs nows nl:
        out.add('$0', '$2')
    match 'load-balancing' nl:
        out.enter('$0')
        l2vpn_pwclass_encap_load_balancing_statements()
    do.return()

grammar l2vpn_pwclass_statements(default):
    match 'encapsulation' fs nows nl:
        out.enter('$0?name="$2"')
        l2vpn_pwclass_encap_statements()
    do.return()

grammar l2vpn_xconnect_group_p2p_neighbor_statements(default):
    match 'pw-class' fs nows nl:
        out.add('$0', '$2')
    do.return()

grammar l2vpn_xconnect_group_p2p_statements(default):
    match 'interface' fs nows nl:
        out.add('$0', '$2')
    match 'neighbor' fs /(?:ipv4 )?/ ipv4_ip fs 'pw-id' fs nows nl:
        out.enter('$0?address="$3"')
        out.add('pw-id', '$7')
        l2vpn_xconnect_group_p2p_neighbor_statements()
    do.return()

grammar l2vpn_xconnect_group_statements(default):
    match 'p2p' fs nows nl:
        out.enter('$0?name="$2"')
        l2vpn_xconnect_group_p2p_statements()
    do.return()

grammar l2vpn_statements(default):
    match 'load-balancing' fs nows fs nows nl:
        out.enter('$0?$2="$4"')
    match 'bridge group' fs nows nl:
        out.enter('$0?name="$2"')
        l2vpn_bridge_group_statements()
    match 'pw-class' fs nows nl:
        out.enter('$0?name="$2"')
        l2vpn_pwclass_statements()
    match 'xconnect group' fs nows nl:
        out.enter('$0?name="$2"')
        l2vpn_xconnect_group_statements()
    logging()
    do.return()

grammar l2vpn(default):
    match 'l2vpn' nl:
        out.enter('$0')
        l2vpn_statements()
    do.return()

grammar logging_statements(default):
    match 'pseudowire' nl:
        out.add('$0')
    do.return()

grammar logging_rules(default):
    match 'alarm' fs nonl nl:
        out.create('$0', '$2')
    match 'all-of-router' nl:
        out.add('$0')
    do.return()

grammar logging(default):
    match 'logging' nl:
        out.enter('logging')
        logging_statements()
    match 'logging' fs 'suppress' fs 'rule' fs nows nl:
        out.enter('$0/$2-$4?name="$6"')
        logging_rules()
    match 'logging' fs 'suppress' fs word fs 'rule' fs nows nl:
        out.enter('$0/$2-$4-$6?name="$8"')
        logging_rules()
    match 'logging' fs nonl nl:
        out.add('logging/option?string="$2"')
    do.return()

grammar sampler_map_statements(default):
    match 'random' fs nonl nl:
        out.add('$0', '$2')
    do.return()

grammar sampler_map(default):
    match 'sampler-map' fs name nl:
        out.enter('$0?name="$2"')
        sampler_map_statements()
    do.return()

grammar service_commands(default):
    match 'service' fs nonl nl:
        out.add('$0/$2')
    do.return()

grammar snmp_statements(default):
    match 'community' fs nows fs nonl nl:
        out.add('community?name="$2"', '$4')
    match 'drop' fs 'report' fs 'acl' fs /IPv[46]/ fs nows nl:
        out.add('$0?type="$2"&$4="$8"&acl-family="$6"')
    match 'engineID local' fs nows nl:
        out.add('engine-id', '$2')
    match 'group' fs nows fs /v2|v3/ fs nonl nl:
        out.add('group?name="$2"/version', '$4')
        out.add('group?name="$2"/options', '$6')
    match 'host' fs nows fs 'traps' fs nows nl:
        out.add('$0?address="$2"/trap?name="$6"')
    match 'ifindex persist' nl:
        out.add('$0')
    match 'ifmib ifalias long' nl:
        out.add('$0')
    match 'ifmib stats cache' nl:
        out.add('$0')
    match 'ipv4 precedence' fs nows nl:
        out.add('$0', '$2')
    match 'mibs' ws nows ws nows nl:
        out.add('$0/$2', '$3')
    match 'queue-length' fs number nl:
        out.add('$0', '$2')
    match 'timeouts' fs nows fs number nl:
        out.add('$0/$2', '$4')
    match 'trap link' fs nonl nl:
        out.add('$0', '$2')
    match 'traps' fs nonl nl:
        out.add('enable-traps?name="$2"')
    match 'trap-source' fs nonl nl:
        out.add('$0', '$2')
    match 'user' fs nows fs nows fs nows fs 'auth' fs nows fs 'encrypted' fs nonl nl:
        out.add('user?name="$2"/group', '$4')
        out.add('user?name="$2"/version', '$6')
        out.add('user?name="$2"/authentication', '$10')
        out.add('user?name="$2"/password', '$14')
    match 'view' fs nows fs nows fs nonl nl:
        out.add('view?name="$2"/allow?name="$4"', '$6')
    do.return()

grammar snmp(default):
    match 'snmp-server' fs:
        out.enter('snmp')
        snmp_statements()
    do.return()

grammar taskgroup_statements(default):
    match 'task' fs /read|write|execute|debug/ fs nonl nl:
        out.add('$2?action="$4"')
    do.return()

grammar taskgroup(default):
    match 'taskgroup' ws nonl nl:
        out.enter('$0?name="$2"')
